# Copy to .env and edit. Every value is optional.
VID_DWN_HOST=127.0.0.1
VID_DWN_PORT=8765
# Default: ~/.local/share/vid-dwn
# VID_DWN_DATA_DIR=/home/you/.local/share/vid-dwn
# Colon-separated roots the app may write media into.
# VID_DWN_ALLOWED_MEDIA_ROOTS=/home/you/Videos:/home/you/Music:/home/you/Downloads
# Override only if the binaries are not on PATH.
# VID_DWN_YTDLP_PATH=/usr/bin/yt-dlp
# VID_DWN_FFMPEG_PATH=/usr/bin/ffmpeg
VID_DWN_MAX_CONCURRENT_DOWNLOADS=1
# Most entries read from one playlist or channel (1-5000).
# VID_DWN_MAX_COLLECTION_ENTRIES=500
VID_DWN_OPEN_BROWSER=true
# Extra origins allowed to talk to the API (development only).
# VID_DWN_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
